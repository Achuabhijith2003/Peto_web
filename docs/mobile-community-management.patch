diff --git a/Mobile/peto_user/lib/widgets/community_delete_section.dart b/Mobile/peto_user/lib/widgets/community_delete_section.dart
new file mode 100644
--- /dev/null
+++ b/Mobile/peto_user/lib/widgets/community_delete_section.dart
@@ -0,0 +1,62 @@
+﻿import 'package:flutter/material.dart';
+import '../services/api_service.dart';
+import '../theme/app_theme.dart';
+
+class CommunityDeleteSection extends StatelessWidget {
+  final String communityId;
+  final String communityName;
+  final bool isOwner;
+  final Future<void> Function() onDeleted;
+  final Future<void> Function(String)? deleteAction;
+  const CommunityDeleteSection({super.key, required this.communityId, required this.communityName,
+    required this.isOwner, required this.onDeleted, this.deleteAction});
+
+  @override
+  Widget build(BuildContext context) {
+    if (!isOwner) return const SizedBox.shrink();
+    return Card(child: Padding(padding: const EdgeInsets.all(16), child: Column(
+      crossAxisAlignment: CrossAxisAlignment.start, children: [
+        const Text('Delete Community', style: TextStyle(fontWeight: FontWeight.bold, color: AppColors.error)),
+        const SizedBox(height: 8),
+        const Text('All members will lose access. Community discussions and media will be retained under Peto’s retention policies.'),
+        const SizedBox(height: 12),
+        FilledButton.icon(style: FilledButton.styleFrom(backgroundColor: AppColors.error), icon: const Icon(Icons.delete_outline),
+          label: const Text('Delete Community'), onPressed: () async {
+            final deleted = await showDialog<bool>(context: context, barrierDismissible: false, builder: (_) => _DeleteCommunityDialog(
+              name: communityName, deleteAction: deleteAction ?? (name) async { await ApiService().deleteCommunity(communityId, name); }));
+            if (deleted == true && context.mounted) await onDeleted();
+          }),
+      ])));
+  }
+}
+
+class _DeleteCommunityDialog extends StatefulWidget {
+  final String name;
+  final Future<void> Function(String) deleteAction;
+  const _DeleteCommunityDialog({required this.name, required this.deleteAction});
+  @override
+  State<_DeleteCommunityDialog> createState() => _DeleteCommunityDialogState();
+}
+class _DeleteCommunityDialogState extends State<_DeleteCommunityDialog> {
+  String confirmation = '';
+  bool busy = false;
+  String? error;
+  @override
+  Widget build(BuildContext context) => PopScope(canPop: !busy, child: AlertDialog(
+    title: const Text('Delete community for everyone?'),
+    content: SingleChildScrollView(child: Column(mainAxisSize: MainAxisSize.min, children: [
+      const Text('All members will lose access. This action cannot be undone here.'),
+      TextField(autofocus: true, enabled: !busy, decoration: InputDecoration(labelText: 'Type ${widget.name} to confirm'),
+        onChanged: (value) => setState(() => confirmation = value)),
+      if (error != null) Text(error!, style: const TextStyle(color: AppColors.error)),
+    ])),
+    actions: [
+      TextButton(onPressed: busy ? null : () => Navigator.pop(context, false), child: const Text('Cancel')),
+      FilledButton(style: FilledButton.styleFrom(backgroundColor: AppColors.error), onPressed: busy || confirmation != widget.name ? null : () async {
+        setState(() {busy = true; error = null;});
+        try {await widget.deleteAction(confirmation); if (context.mounted) Navigator.pop(context, true);}
+        catch (_) {if (mounted) setState(() {busy = false; error = 'Unable to delete community. Check your access and try again.';});}
+      }, child: Text(busy ? 'Deleting…' : 'Delete for everyone')),
+    ],
+  ));
+}
diff --git a/Mobile/peto_user/test/community_delete_test.dart b/Mobile/peto_user/test/community_delete_test.dart
new file mode 100644
--- /dev/null
+++ b/Mobile/peto_user/test/community_delete_test.dart
@@ -0,0 +1,48 @@
+﻿import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:peto_user/widgets/community_delete_section.dart';
+
+void main() {
+  testWidgets('only owners see Delete Community', (tester) async {
+    await tester.pumpWidget(MaterialApp(home: Scaffold(body: CommunityDeleteSection(
+      communityId: 'circle', communityName: 'Circle', isOwner: false, onDeleted: () async {}))));
+    expect(find.text('Delete Community'), findsNothing);
+  });
+  testWidgets('typed name required; deletion disables controls and completes', (tester) async {
+    final gate = Completer<void>();
+    var calls = 0;
+    var completed = false;
+    await tester.pumpWidget(MaterialApp(home: Scaffold(body: CommunityDeleteSection(
+      communityId: 'circle', communityName: 'Circle', isOwner: true,
+      deleteAction: (name) async {expect(name, 'Circle'); calls++; await gate.future;}, onDeleted: () async {completed = true;}))));
+    await tester.tap(find.widgetWithText(FilledButton, 'Delete Community'));
+    await tester.pumpAndSettle();
+    expect(tester.widget<FilledButton>(find.widgetWithText(FilledButton, 'Delete for everyone')).onPressed, isNull);
+    await tester.enterText(find.byType(TextField), 'wrong');
+    await tester.pump();
+    expect(tester.widget<FilledButton>(find.widgetWithText(FilledButton, 'Delete for everyone')).onPressed, isNull);
+    await tester.enterText(find.byType(TextField), 'Circle');
+    await tester.pump();
+    await tester.tap(find.widgetWithText(FilledButton, 'Delete for everyone'));
+    await tester.pump();
+    expect(tester.widget<FilledButton>(find.byType(FilledButton).last).onPressed, isNull);
+    expect(tester.widget<TextButton>(find.widgetWithText(TextButton, 'Cancel')).onPressed, isNull);
+    gate.complete();
+    await tester.pumpAndSettle();
+    expect(calls, 1);expect(completed, isTrue);
+  });
+  testWidgets('deletion error keeps dialog and permits retry', (tester) async {
+    var completed = false;
+    await tester.pumpWidget(MaterialApp(home: Scaffold(body: CommunityDeleteSection(
+      communityId: 'circle', communityName: 'Circle', isOwner: true,
+      deleteAction: (_) async {throw StateError('Denied');}, onDeleted: () async {completed = true;}))));
+    await tester.tap(find.widgetWithText(FilledButton, 'Delete Community'));
+    await tester.pumpAndSettle();
+    await tester.enterText(find.byType(TextField), 'Circle');await tester.pump();
+    await tester.tap(find.widgetWithText(FilledButton, 'Delete for everyone'));await tester.pumpAndSettle();
+    expect(find.textContaining('Unable to delete community'), findsOneWidget);
+    expect(completed, isFalse);
+    expect(tester.widget<FilledButton>(find.widgetWithText(FilledButton, 'Delete for everyone')).onPressed, isNotNull);
+  });
+}
