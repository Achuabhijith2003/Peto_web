VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx

# Configurable official Google Play Store URL for Peto Android app promotion banner.
# Example: https://play.google.com/store/apps/details?id=<official-package-name>
# Leave empty until the app is officially published to the Google Play Store.
VITE_PLAY_STORE_URL=

# Presence heartbeat and Active Pals toggle (default: false to preserve Supabase quota)
VITE_PRESENCE_ENABLED=false
