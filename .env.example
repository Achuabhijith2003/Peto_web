NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173

SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=your-jwt-secret-key

# Firebase Push Notifications (for sending notifications when mobile app is closed)
# Paste service account JSON string or path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=
# Render Key Value (Redis-compatible distributed rate limiting & safe caching)
# In production on Render: use the "Internal Key Value URL" (e.g. rediss://default:***@red-***:6379)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
REDIS_CACHE_ENABLED=false
REDIS_RATE_LIMIT_ENABLED=false