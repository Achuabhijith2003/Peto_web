# Ignore Environment & Secret files
.env
.env.*
!.env.example

# Ignore Node.js build & dependency directories
node_modules/
dist/
build/
coverage/

# Ignore Git & Editor configurations
.git/
.gitignore
.github/
.vscode/
.idea/
*.swp
*.swo

# Ignore OS & Temporary files
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore temporary uploads
uploads/*
!uploads/.gitkeep
temp/*
